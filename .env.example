# Catalogue source. Use fixture for an offline catalogue.
CATALOGUE_SOURCE=fake-store

# Local Compose defaults. SMTP is internal to the Compose network.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=catalogue@example.test
SALES_EMAIL=sales@example.test
# For another SMTP provider, set host, port, sender and recipient. Use SMTP_SECURE=true for implicit TLS.
# Supply both credentials for authenticated SMTP or leave both blank for Mailpit.
# SMTP_USER=
# SMTP_PASS=
